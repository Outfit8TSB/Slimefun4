<configuration
        xmlns="https://github.com/qoomon/maven-git-versioning-extension"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/qoomon/maven-git-versioning-extension
            https://qoomon.github.io/maven-git-versioning-extension/configuration-7.1.0.xsd"
>
   <refs>
       <ref type="branch">
           <pattern>dev</pattern>
           <version>
               ${version.core}-alpha-${commit.short}
           </version>
       </ref>
   </refs>
</configuration>